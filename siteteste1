<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Memórias Matemáticas - Podcast UFPR</title>
    
    <style>
        /* --- CONFIGURAÇÃO DE CORES --- */
        /* Para mudar a cor principal do site, basta alterar o código da cor aqui embaixo */
        :root {
            --cor-principal: #003c71; /* Azul escuro institucional */
            --cor-secundaria: #13294b; 
            --cor-fundo: #f8f9fa;
            --cor-texto: #333333;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background-color: var(--cor-fundo);
            color: var(--cor-texto);
            line-height: 1.6;
        }

        /* Cabeçalho / Banner Principal */
        header {
            background: linear-gradient(135deg, var(--cor-principal), var(--cor-secundaria));
            color: white;
            text-align: center;
            padding: 4rem 1rem;
        }
        header h1 {
            font-size: 2.5rem;
            margin: 0 0 10px 0;
        }
        header p {
            font-size: 1.2rem;
            max-width: 600px;
            margin: 0 auto 20px auto;
            opacity: 0.9;
        }

        /* Botões das Redes Sociais */
        .botoes-redes a {
            display: inline-block;
            background-color: white;
            color: var(--cor-principal);
            text-decoration: none;
            padding: 10px 20px;
            margin: 5px;
            border-radius: 5px;
            font-weight: bold;
            transition: all 0.3s;
        }
        .botoes-redes a:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }

        /* Container que centraliza o conteúdo */
        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 2rem 1rem;
        }

        /* Caixas de cada seção */
        section {
            background-color: white;
            padding: 2rem;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
            margin-bottom: 2rem;
        }
        h2 {
            color: var(--cor-principal);
            border-bottom: 2px solid #eee;
            padding-bottom: 10px;
            margin-top: 0;
        }

        /* Grade de Episódios */
        .grade-episodios {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }
        .episodio iframe {
            width: 100%;
            height: 200px;
            border-radius: 8px;
            border: none;
        }
        .episodio h3 {
            font-size: 1.1rem;
            margin: 10px 0 5px 0;
        }

        /* Grade de Participantes */
        .grade-equipe {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 20px;
            text-align: center;
        }
        .membro img {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid var(--cor-principal);
        }
        .membro h4 {
            margin: 10px 0 5px 0;
        }
        .membro p {
            margin: 0;
            font-size: 0.9rem;
            color: #666;
        }

        /* Rodapé */
        footer {
            text-align: center;
            padding: 1.5rem;
            background-color: #222;
            color: white;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <!-- CABEÇALHO -->
    <header>
        <h1>Memórias Matemáticas</h1>
        <p>Um projeto de extensão da Universidade Federal do Paraná. Conheça as histórias e as trajetórias dos professores de Matemática.</p>
        
        <div class="botoes-redes">
            <a href="https://www.youtube.com/@MemóriasMatemáticas" target="_blank">▶ Inscreva-se no YouTube</a>
            <a href="https://www.instagram.com/memoriasmatematicas/" target="_blank">📷 Siga no Instagram</a>
        </div>
    </header>

    <div class="container">
        
        <!-- SEÇÃO DE EPISÓDIOS -->
        <section>
            <h2>Últimos Episódios</h2>
            <div class="grade-episodios">
                
                <!-- Episódio 1 -->
                <div class="episodio">
                    <!-- O link dentro do 'src' é tirado da opção "Compartilhar > Incorporar" do YouTube -->
                    <iframe src="https://www.youtube.com/embed/InG9IT8W2Vo" allowfullscreen></iframe>
                    <h3>Memórias Matemáticas #8 - Prof. Roberto Ribeiro</h3>
                </div>

                <!-- Episódio 2 -->
                <div class="episodio">
                    <iframe src="https://www.youtube.com/embed/n1QnPKw-2Tk" allowfullscreen></iframe>
                    <h3>Memórias Matemáticas #7 - Prof. Cleber Costa Neto</h3>
                </div>

                <!-- Episódio 3 -->
                <div class="episodio">
                    <iframe src="https://www.youtube.com/embed/bBZm97jhUPM" allowfullscreen></iframe>
                    <h3>Memórias Matemáticas #1 - Prof. Adonai Schlup Sant'Anna</h3>
                </div>

            </div>
        </section>

        <!-- SEÇÃO DA EQUIPE -->
        <section>
            <h2>Nossa Equipe</h2>
            <div class="grade-equipe">
                
                <!-- Você -->
                <div class="membro">
                    <img src="LINK_DA_SUA_FOTO_AQUI.jpg" alt="João Vitor">
                    <h4>João Vitor</h4>
                    <p>Produção e Edição</p>
                </div>

                <!-- Adicione mais membros copiando o bloco acima -->
                <div class="membro">
                    <img src="LINK_DA_FOTO.jpg" alt="Nome do Colega">
                    <h4>Nome</h4>
                    <p>Função no Projeto</p>
                </div>

            </div>
        </section>

    </div>

    <!-- RODAPÉ -->
    <footer>
        <p>Memórias Matemáticas © 2026 - Licenciatura em Matemática (UFPR)</p>
    </footer>

</body>
</html>
